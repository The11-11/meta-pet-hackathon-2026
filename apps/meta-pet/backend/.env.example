# Server-side only. Never copy this key into EXPO_PUBLIC_ variables.
MODEL_API_KEY=
MODEL_NAME=muse-spark-1.3
PORT=8787
# Loopback is the safe default. Use 0.0.0.0 only on a trusted local network
# when testing from a physical phone, and set a token for live mode.
HOST=127.0.0.1
MUSE_CLIENT_TOKEN=
# Comma-separated web origins. Native mobile requests do not send Origin.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8083

# Facebook Login / Better Auth. All secrets remain on this server.
# Facebook App ID and App Secret: Meta developer app > App Settings > Basic.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Generate a high-entropy secret of at least 32 characters; do not use a sample.
BETTER_AUTH_SECRET=
# Stable backend origin. Register <origin>/api/auth/callback/facebook in Meta.
# Use public HTTPS for a real phone/production callback.
BETTER_AUTH_URL=
# Exact web frontend origins only. The metapet:// native scheme is trusted internally.
AUTH_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:8083
# Relative paths resolve inside backend/. Run npm run auth:setup before sign-in.
AUTH_DATABASE_PATH=data/auth.sqlite
