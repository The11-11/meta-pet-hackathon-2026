# Public address of the Muse Pet authentication backend. No secret belongs here.
EXPO_PUBLIC_AUTH_URL=http://localhost:8787
# A physical phone needs a reachable HTTPS address and a development build.
# Configure the Muse backend base URL and separate development token in app Settings.
# The token remains in memory; it is not persisted with the app's care records.
# Server-only MODEL_API_KEY and MUSE_CLIENT_TOKEN belong in backend/.env.
# See backend/.env.example and backend/README.md for the server configuration.
# Never add a model provider key to an EXPO_PUBLIC_ variable or the mobile bundle.
